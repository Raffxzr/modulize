#!/usr/bin/env bash
# {{MODULE_NAME}} build script.
#
# Produces a flashable Magisk / KernelSU / APatch zip from this repository.
# Generated by modulize.
#
# Usage:
#   ./build.sh                 # dist/{{MODULE_ID}}-<version>.zip
#   BUILD_DIR=... ./build.sh   # custom staging directory
#   DIST_DIR=... ./build.sh    # custom output directory

set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BUILD_DIR="${BUILD_DIR:-$ROOT_DIR/build}"
DIST_DIR="${DIST_DIR:-$ROOT_DIR/dist}"
STAGE_DIR="$BUILD_DIR/module"

fail() { printf 'error: %s\n' "$*" >&2; exit 1; }

prop() {
  sed -n "s/^$1=//p" "$ROOT_DIR/module.prop" | tr -d '\r' | head -n 1
}

[[ -f "$ROOT_DIR/module.prop" ]] || fail "module.prop not found"

MODULE_ID=$(prop id)
VERSION=$(prop version)
VERSION_CODE=$(prop versionCode)

[[ -n "$MODULE_ID" ]] || fail "module.prop is missing id"
[[ -n "$VERSION" ]] || fail "module.prop is missing version"
[[ -n "$VERSION_CODE" ]] || fail "module.prop is missing versionCode"
[[ "$VERSION_CODE" =~ ^[0-9]+$ ]] || fail "versionCode must be an integer (got '$VERSION_CODE')"

command -v zip >/dev/null 2>&1 || fail "'zip' is required to build the module"

OUTPUT="$DIST_DIR/${MODULE_ID}-${VERSION}.zip"

# Refuse to package CRLF shell scripts; they break on-device execution.
while IFS= read -r -d '' file; do
  if LC_ALL=C grep -q $'\r' "$file"; then
    fail "CRLF line endings found in $file; convert it to LF"
  fi
done < <(
  find "$ROOT_DIR" -type f \
    -not -path "$ROOT_DIR/.git/*" \
    -not -path "$ROOT_DIR/build/*" \
    -not -path "$ROOT_DIR/dist/*" \
    \( -name '*.sh' -o -path "$ROOT_DIR/system/bin/*" -o -path "$ROOT_DIR/system/xbin/*" \) \
    -print0
)

info() { printf '==> %s\n' "$*"; }

info "Building ${MODULE_ID} ${VERSION} (versionCode ${VERSION_CODE})"

rm -rf "$STAGE_DIR" "$OUTPUT"
mkdir -p "$STAGE_DIR" "$DIST_DIR"

# Root-level module files.
for file in module.prop system.prop sepolicy.rule customize.sh service.sh \
  post-fs-data.sh boot-completed.sh action.sh uninstall.sh; do
  [[ -f "$ROOT_DIR/$file" ]] || continue
  case "$file" in
    *.sh) install -m 0755 "$ROOT_DIR/$file" "$STAGE_DIR/$file" ;;
    *) install -m 0644 "$ROOT_DIR/$file" "$STAGE_DIR/$file" ;;
  esac
done

# Module payload trees.
for tree in META-INF system webroot common; do
  [[ -d "$ROOT_DIR/$tree" ]] || continue
  mkdir -p "$STAGE_DIR/$tree"
  cp -R "$ROOT_DIR/$tree/." "$STAGE_DIR/$tree/"
done

# Optional extra paths declared in module.include.
if [[ -f "$ROOT_DIR/module.include" ]]; then
  while IFS= read -r entry || [[ -n "$entry" ]]; do
    entry="${entry%%#*}"
    entry="$(printf '%s' "$entry" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [[ -z "$entry" ]] && continue
    [[ -e "$ROOT_DIR/$entry" ]] || fail "module.include entry not found: $entry"
    mkdir -p "$STAGE_DIR/$(dirname "$entry")"
    cp -R "$ROOT_DIR/$entry" "$STAGE_DIR/$entry"
  done <"$ROOT_DIR/module.include"
fi

[[ -f "$STAGE_DIR/module.prop" ]] || fail "staged module is missing module.prop"
[[ -f "$STAGE_DIR/customize.sh" ]] || fail "staged module is missing customize.sh"
[[ -f "$STAGE_DIR/META-INF/com/google/android/update-binary" ]] \
  || fail "staged module is missing META-INF/com/google/android/update-binary"

# Normalise permissions inside the zip.
find "$STAGE_DIR" -type d -exec chmod 0755 {} +
find "$STAGE_DIR" -type f -exec chmod 0644 {} +

for file in "$STAGE_DIR"/*.sh; do
  [[ -f "$file" ]] && chmod 0755 "$file"
done

for dir in "$STAGE_DIR/system/bin" "$STAGE_DIR/system/xbin" "$STAGE_DIR/webroot/cgi-bin"; do
  [[ -d "$dir" ]] && find "$dir" -type f -exec chmod 0755 {} +
done

[[ -f "$STAGE_DIR/META-INF/com/google/android/update-binary" ]] \
  && chmod 0755 "$STAGE_DIR/META-INF/com/google/android/update-binary"

info "Packaging ${OUTPUT}"
(
  cd "$STAGE_DIR"
  zip -r -9 -X "$OUTPUT" . >/dev/null
)

[[ -f "$OUTPUT" ]] || fail "zip was not created"

info "Created ${OUTPUT}"
printf '    size:   %s\n' "$(du -h "$OUTPUT" | cut -f1)"
if command -v sha256sum >/dev/null 2>&1; then
  printf '    sha256: %s\n' "$(sha256sum "$OUTPUT" | cut -d' ' -f1)"
fi
