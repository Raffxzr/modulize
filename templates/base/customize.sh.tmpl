#!/sbin/sh
# {{MODULE_NAME}} installer for Magisk / KernelSU / APatch.
# Generated by modulize.
SKIPUNZIP=1
ASH_STANDALONE=1

print_banner() {
  ui_print "************************************************"
  ui_print "              {{MODULE_NAME}}"
  ui_print "              {{VERSION}} by {{AUTHOR}}"
  ui_print "************************************************"
}

[ "$BOOTMODE" = true ] || abort "! Install through Magisk, KernelSU, or APatch"
[ "$API" -ge {{MIN_SDK}} ] || abort "! Android SDK {{MIN_SDK}}+ is required"

print_banner

ui_print "- Extracting module files..."
unzip -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >&2

ui_print "- Preparing persistent data directory..."
mkdir -p "/data/adb/{{MODULE_ID}}"

ui_print "- Setting permissions..."
set_perm_recursive "$MODPATH" 0 0 0755 0644
set_perm "$MODPATH/customize.sh" 0 0 0755
[ -f "$MODPATH/service.sh" ] && set_perm "$MODPATH/service.sh" 0 0 0755
[ -f "$MODPATH/action.sh" ] && set_perm "$MODPATH/action.sh" 0 0 0755
[ -f "$MODPATH/uninstall.sh" ] && set_perm "$MODPATH/uninstall.sh" 0 0 0755
[ -f "$MODPATH/post-fs-data.sh" ] && set_perm "$MODPATH/post-fs-data.sh" 0 0 0755
[ -d "$MODPATH/system/bin" ] && set_perm_recursive "$MODPATH/system/bin" 0 0 0755 0755
[ -d "$MODPATH/system/xbin" ] && set_perm_recursive "$MODPATH/system/xbin" 0 0 0755 0755
[ -d "$MODPATH/webroot/cgi-bin" ] && set_perm_recursive "$MODPATH/webroot/cgi-bin" 0 0 0755 0755
[ -d "/data/adb/{{MODULE_ID}}" ] && set_perm_recursive "/data/adb/{{MODULE_ID}}" 0 0 0755 0755

ui_print "- {{MODULE_NAME}} installed. Reboot to apply."
