<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{MODULE_NAME}}</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0b1020;
      --card: #131a2e;
      --line: #26314f;
      --text: #e6ebff;
      --muted: #92a0c4;
      --accent: #38bdf8;
      --ok: #34d399;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
      background: radial-gradient(circle at top, #17213d 0, var(--bg) 55%);
      color: var(--text);
      font: 15px/1.6 ui-sans-serif, system-ui, -apple-system, sans-serif;
    }

    main {
      width: min(680px, 100%);
      background: color-mix(in srgb, var(--card) 92%, transparent);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 28px;
      box-shadow: 0 24px 80px #0008;
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    h1 { margin: 0 0 8px; font-size: clamp(28px, 5vw, 40px); }

    p { margin: 0 0 20px; color: var(--muted); }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }

    .card {
      padding: 14px 16px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #0d1426;
    }

    .label {
      display: block;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .value { font-weight: 700; }

    .status { color: var(--ok); }

    code {
      display: block;
      padding: 12px 14px;
      overflow-x: auto;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: #091021;
      color: #b9e8ff;
      font: 13px/1.5 ui-monospace, monospace;
      white-space: pre;
    }

    footer { margin-top: 20px; color: var(--muted); font-size: 12px; }
  </style>
</head>
<body>
  <main>
    <p class="eyebrow">Magisk / KernelSU / APatch</p>
    <h1>{{MODULE_NAME}}</h1>
    <p>{{DESCRIPTION}}</p>

    <div class="grid">
      <div class="card">
        <span class="label">Version</span>
        <span class="value">{{VERSION}}</span>
      </div>
      <div class="card">
        <span class="label">Author</span>
        <span class="value">{{AUTHOR}}</span>
      </div>
      <div class="card">
        <span class="label">Status</span>
        <span class="value status">Active</span>
      </div>
    </div>

    <span class="label">Terminal</span>
    <code>su -c {{MODULE_ID}} status</code>

    <footer>
      Generated by
      <a href="https://github.com/Raffxzr/raff-module">raff-module</a>.
      Replace this page with your own WebUI.
    </footer>
  </main>
</body>
</html>
