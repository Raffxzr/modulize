#!/usr/bin/env bash
# modulize — scaffold and manage Magisk / KernelSU / APatch modules.
#
# Usage:
#   modulize init [directory] [options]
#   modulize add <component> [directory]
#   modulize bump [patch|minor|major|<version>] [directory]
#   modulize build [directory]
#   modulize doctor [directory] [--strict] [--fix]
#   modulize lint [directory]
#   modulize version

set -euo pipefail

# Resolve the repository root even when the CLI is symlinked into $PATH.
_self=${BASH_SOURCE[0]}
while [[ -L "$_self" ]]; do
  _dir=$(cd -P "$(dirname "$_self")" && pwd)
  _self=$(readlink "$_self")
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
ROOT_DIR=$(cd -P "$(dirname "$_self")" && pwd)
export ROOT_DIR

MODULIZE_VERSION="0.3.0"
export MODULIZE_VERSION

# shellcheck source=lib/common.sh
source "$ROOT_DIR/lib/common.sh"

usage() {
  cat <<'EOF'
modulize — scaffold and manage Magisk / KernelSU / APatch modules

Usage:
  modulize init [directory] [options]
  modulize add <component> [directory] [options]
  modulize bump [patch|minor|major|<version>] [directory] [options]
  modulize build [directory]
  modulize doctor [directory] [--fix] [--strict]
  modulize lint [directory] [--strict]
  modulize version
  modulize help

Commands:
  init       Scaffold a new production-ready root module
  add        Add modular components (webui, action, service, cli, post-fs-data, workflow)
  bump       Increment version & sync module.prop, update.json, and CHANGELOG.md
  build      Compile the module into a flashable zip
  doctor     Validate metadata, line endings, OTA manifests, and workflows (--fix to auto-repair)
  lint       Check shell scripts syntax, JSON manifests, and template placeholders
  version    Show current modulize version

Run "modulize <command> --help" for detailed command options.
EOF
}

version() {
  printf 'modulize %s\n' "$MODULIZE_VERSION"
}

main() {
  local command=${1:-help}
  [[ $# -gt 0 ]] && shift

  case "$command" in
    init)
      # shellcheck source=lib/init.sh
      source "$ROOT_DIR/lib/init.sh"
      cmd_init "$@"
      ;;
    add)
      # shellcheck source=lib/add.sh
      source "$ROOT_DIR/lib/add.sh"
      cmd_add "$@"
      ;;
    bump)
      # shellcheck source=lib/bump.sh
      source "$ROOT_DIR/lib/bump.sh"
      cmd_bump "$@"
      ;;
    build)
      # shellcheck source=lib/build.sh
      source "$ROOT_DIR/lib/build.sh"
      cmd_build "$@"
      ;;
    doctor)
      # shellcheck source=lib/doctor.sh
      source "$ROOT_DIR/lib/doctor.sh"
      cmd_doctor "$@"
      ;;
    lint)
      # shellcheck source=lib/lint.sh
      source "$ROOT_DIR/lib/lint.sh"
      cmd_lint "$@"
      ;;
    version | --version | -v)
      version
      ;;
    help | --help | -h)
      usage
      ;;
    *)
      error "unknown command: $command"
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
